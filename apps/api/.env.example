# =============================================================================
# Konfigurasi API. Salin ke .env lalu isi.
#   [WAJIB]   aplikasi tidak jalan bila kosong
#   [PRODUKSI] wajib diisi saat deploy (Railway), boleh dibiarkan saat lokal
#   [OPSIONAL] sudah punya nilai bawaan; hapus saja bila tidak perlu
# =============================================================================

# ---------- WAJIB ----------

# PostgreSQL. Lokal: container Docker, mis.
#   docker run -d --name kominfo-pg -e POSTGRES_PASSWORD=pgdev123 -e POSTGRES_DB=kominfo_pd_kg -p 5433:5432 postgres:17
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:pgdev123@localhost:5433/kominfo_pd_kg

# Minimal 32 karakter. Buat dengan: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Alamat publik API ini (produksi: domain Railway, diawali https://, tanpa garis miring di akhir)
BETTER_AUTH_URL=http://localhost:3001

# Alamat publik web (produksi: alamat Vercel, tanpa garis miring di akhir)
FRONTEND_URL=http://localhost:3000

# ---------- PRODUKSI ----------

NODE_ENV=development

# Akun admin pertama, dibuat oleh seed
SEED_ADMIN_EMAIL=admin@diskominfo.local
SEED_ADMIN_PASSWORD=

# Penyimpanan foto dan PDF (Cloudinary). Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Kosong = file disimpan di STORAGE_DIR (hanya cocok untuk lokal)
CLOUDINARY_URL=

# Email lewat API Brevo (Railway memblokir SMTP). Kosong = email lewat SMTP di bawah
BREVO_API_KEY=
# Alamat pengirim; harus sender yang sudah diverifikasi di Brevo
SMTP_FROM="Aplikasi Pendataan Kegiatan <no-reply@diskominfo.local>"

# ---------- OPSIONAL ----------

# Port server. Bawaan 3001 (sama dengan Dockerfile). Railway menyuntikkan PORT sendiri (mis. 8080),
# jadi di Railway isi PORT=3001 agar sama dengan port domain di Settings -> Networking
PORT=3001

# false = matikan email pengingat otomatis
PENGINGAT_AKTIF=true

# Nama folder di Cloudinary
CLOUDINARY_FOLDER=kominfo-kegiatan

# Jumlah koneksi database maksimal per proses
DATABASE_POOL_MAX=10

# Folder penyimpanan lokal bila Cloudinary tidak diisi
STORAGE_DIR=./storage

# User DB khusus aplikasi dengan hak terbatas (dibuat oleh scripts/hak-akses.ts)
APP_DB_USER=
APP_DB_PASSWORD=

# SMTP lokal (Mailpit) dipakai bila BREVO_API_KEY kosong. Tidak dipakai di Railway
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
