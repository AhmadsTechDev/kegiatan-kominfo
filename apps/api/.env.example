NODE_ENV=development
PORT=3001
# PostgreSQL. Development: container Docker lokal, mis.
#   docker run -d --name kominfo-pg -e POSTGRES_PASSWORD=pgdev123 -e POSTGRES_DB=kominfo_pd_kg -p 5433:5432 postgres:17
# Produksi (Supabase): Project Settings -> Database -> Connection string -> mode "Transaction pooler" (port 6543)
DATABASE_URL=postgres://postgres:pgdev123@localhost:5433/kominfo_pd_kg
# Jumlah koneksi maksimal per proses
DATABASE_POOL_MAX=10
# Opsional: user DB khusus aplikasi dengan hak terbatas (dibuat oleh scripts/hak-akses.ts)
APP_DB_USER=
APP_DB_PASSWORD=
# Minimal 32 karakter
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@diskominfo.local
SEED_ADMIN_PASSWORD=
STORAGE_DIR=./storage
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kominfo-kegiatan
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aplikasi Pendataan Kegiatan <no-reply@diskominfo.local>"
BREVO_API_KEY=
# false = matikan email pengingat otomatis
PENGINGAT_AKTIF=true
