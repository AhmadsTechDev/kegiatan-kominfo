# =============================================================================
# Konfigurasi Backend API (Salin ke .env)
# =============================================================================

# --- WAJIB ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:pgdev123@localhost:5433/kominfo_pd_kg
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- AKUN ADMIN AWAL (Seed) ---
SEED_ADMIN_EMAIL=admin@diskominfo.local
SEED_ADMIN_PASSWORD=

# --- PENYIMPANAN BERKAS ---
# Kosong = simpan di folder lokal STORAGE_DIR; Diisi = simpan di Cloudinary
STORAGE_DIR=./storage
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kominfo-kegiatan

# --- EMAIL ---
# Isi BREVO_API_KEY untuk pakai Brevo API, atau kosongkan untuk pakai SMTP di bawah
BREVO_API_KEY=
SMTP_FROM="Aplikasi Pendataan Kegiatan <no-reply@diskominfo.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- OPSIONAL ---
PENGINGAT_AKTIF=true
DATABASE_POOL_MAX=10
APP_DB_USER=
APP_DB_PASSWORD=
