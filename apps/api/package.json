{
  "name": "diskominfo-kegiatan-backend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "prisma migrate deploy && bun scripts/hak-akses.ts && bun prisma/seed.ts && bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.7",
    "cloudinary": "^2.11.0",
    "elysia": "^1.4.30",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.1.1",
    "prisma": "^7.10.1",
    "react": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
