# Pengaturan deploy VPS dengan docker compose. Salin menjadi .env di root proyek lalu isi:
#   cp docker.env.example .env
# Nilai di sini dibaca docker-compose.yml dan diteruskan ke container backend.

# ---------- Wajib ----------
# Domain publik yang sudah diarahkan (DNS A record) ke IP VPS. Caddy membuat sertifikat HTTPS otomatis.
DOMAIN=kegiatan.diskominfo.palembang.go.id
# Kata sandi PostgreSQL (dipakai di dalam URL, jadi cukup huruf dan angka)
DB_PASSWORD=
# Minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
BETTER_AUTH_SECRET=

# ---------- Akun admin pertama (dibuat sekali saat backend pertama menyala) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- Email (undangan akun, permintaan akun, pengingat) ----------
# Pilih salah satu: SMTP, atau Brevo (BREVO_API_KEY diisi -> SMTP diabaikan)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aplikasi Pendataan Kegiatan <no-reply@domain-anda>"
BREVO_API_KEY=

# ---------- Penyimpanan berkas (opsional) ----------
# Kosong = foto/dokumen disimpan di volume Docker "storage" di VPS.
# Diisi (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) = disimpan privat di Cloudinary.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kominfo-kegiatan

# ---------- Lanjutan (opsional) ----------
# Bila aplikasi dibuka lewat alamat lain selain https://DOMAIN (mis. port khusus)
# APP_URL=https://kegiatan.contoh.id:8443
# HTTP_PORT=80
# HTTPS_PORT=443
